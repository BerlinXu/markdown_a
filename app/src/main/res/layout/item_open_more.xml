<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/open_more_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/screen_h_pad"
    android:layout_marginTop="16dp"
    android:layout_marginEnd="@dimen/screen_h_pad"
    android:layout_marginBottom="20dp"
    android:background="@drawable/bg_dashed"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="15dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/open_other"
        android:src="@drawable/ic_folder"
        app:tint="@color/brand" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_other"
            android:textColor="@color/ink"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/open_other_hint"
            android:textColor="@color/ink3"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
