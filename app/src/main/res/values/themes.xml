<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MDReader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/brand_ink</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/brand_ink</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink2</item>
        <item name="colorOutline">@color/line2</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorError">@color/accent</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink2</item>
        <item name="android:textColorHint">@color/ink3</item>

        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSelectHandle" tools:ignore="NewApi">@color/accent</item>
    </style>

    <style name="Theme.Transparent" parent="Theme.MDReader">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoDisplay">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- 顶栏标题：Fraunces 感的中文字重，用 serif 加粗贴近原型 -->
    <style name="TextAppearance.AppTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AppSub" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/ink3</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="MD.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="MD.Tool" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/ink2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:minHeight">36dp</item>
    </style>
</resources>
